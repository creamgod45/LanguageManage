<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <module name="LanguageManage.shared"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
                parentId="tools"
                id="cg.creamgod45.localization.LanguageManagerSettings"
                instance="cg.creamgod45.settings.LanguageManagerSettingsConfigurable"
                bundle="messages.LanguageManagerFrontendBundle"
                key="settings.display.name"/>
        <toolWindow
                id="Language Manager"
                anchor="right"
                factoryClass="cg.creamgod45.toolWindow.LanguageManagerToolWindowFactory"
                icon="cg.creamgod45.LanguageManagerIcons.ToolWindow"/>
        <notificationGroup id="LanguageManager" displayType="BALLOON"/>
        <postStartupActivity implementation="cg.creamgod45.localization.ui.DynamicSourceGutterStartupActivity"/>
    </extensions>

    <actions>
        <group id="cg.creamgod45.localization.ProjectViewGroup"
               class="cg.creamgod45.localization.ui.LanguageManagerProjectViewActionGroup"
               popup="true">
            <action id="cg.creamgod45.localization.ExcludeFoldersFromActiveScheme"
                    class="cg.creamgod45.localization.ui.ExcludeFoldersFromActiveSchemeAction"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </group>
        <group id="cg.creamgod45.localization.EditorSelectionGroup"
               class="cg.creamgod45.localization.ui.LanguageManagerEditorActionGroup"
               popup="true">
            <action id="cg.creamgod45.localization.CreateTranslationFromSelection"
                    class="cg.creamgod45.localization.ui.CreateTranslationFromSelectionAction"/>
            <group id="cg.creamgod45.localization.SearchSelectedTranslationGroup"
                   class="cg.creamgod45.localization.ui.SearchSelectedTranslationGroup"
                   popup="true">
                <action id="cg.creamgod45.localization.SearchSelectedTranslationExact"
                        class="cg.creamgod45.localization.ui.SearchSelectedTranslationExactAction"/>
                <action id="cg.creamgod45.localization.SearchSelectedTranslationFuzzy"
                        class="cg.creamgod45.localization.ui.SearchSelectedTranslationFuzzyAction"/>
            </group>
            <group id="cg.creamgod45.localization.DynamicSourceActionGroup"
                   class="cg.creamgod45.localization.ui.DynamicSourceActionGroup"
                   popup="true">
                <action id="cg.creamgod45.localization.CreateDynamicMarker"
                        class="cg.creamgod45.localization.ui.CreateDynamicMarkerAction"/>
                <action id="cg.creamgod45.localization.AddNonInvasiveDynamicSource"
                        class="cg.creamgod45.localization.ui.AddNonInvasiveDynamicSourceAction"/>
                <action id="cg.creamgod45.localization.EditDynamicMarker"
                        class="cg.creamgod45.localization.ui.EditDynamicMarkerAction"
                        icon="AllIcons.Actions.Edit">
                    <add-to-group group-id="Floating.CodeToolbar" anchor="last"/>
                </action>
            </group>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
